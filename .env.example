# ─── Discord OAuth (Developer Portal → your Application) ───────────────────────
# Application ID — must match both VITE_DISCORD_CLIENT_ID (client bundle)
# and DISCORD_CLIENT_ID (server token-exchange).
VITE_DISCORD_CLIENT_ID=your_client_id_here
DISCORD_CLIENT_ID=your_client_id_here
# OAuth2 → Secrets → "Reset Secret"
DISCORD_CLIENT_SECRET=your_client_secret_here

# ─── Server (Railway / local) ──────────────────────────────────────────────────
# Railway injects PORT automatically in production. Leave unset to use 3001 in dev.
PORT=3001
# Allowed CORS origins. Single URL or comma-separated list (preview deploys + prod + Discord).
# Railway & *.discordsays.com are whitelisted automatically by regex.
CLIENT_URL=http://localhost:5173
# Set to "true" in dev to skip the Discord instance-participants + bearer-token
# auth checks. NEVER set in production.
SKIP_INSTANCE_VERIFY=true
# Optional: control Postgres SSL behaviour ("disable" forces no SSL — only for local).
PGSSLMODE=

# ─── Persistence ───────────────────────────────────────────────────────────────
# Postgres connection string. Railway auto-injects this when you attach a
# Postgres plugin to the service. Leave unset locally to use the JSON-file
# store in apps/server/data/meta.json (gitignored).
DATABASE_URL=

# ─── Game server (client → Colyseus) ───────────────────────────────────────────
# Local dev uses ws:// to localhost. Production should be wss:// to your Railway
# WebSocket URL — and the Discord URL Mapping `/colyseus` should point at it.
VITE_GAME_SERVER_URL=ws://localhost:3001
